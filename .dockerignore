.git/
.gitignore

# Logs
*.log
npm-debug.log*

# Éditeurs et OS
.DS_Store
.vscode/
.idea/

# Documentation et preuves (inutiles dans l'image)
docs/
preuves/
README.md

# Fichiers de CI/CD
.github/
.gitlab-ci.yml

# Scripts de déploiement
scripts/
